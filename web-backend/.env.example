# Server
PORT=5000
MONGODB_URI=
# Comma separated list of origins allowed to call the API with credentials.
FRONTEND_URL=http://localhost:5173

# Authentication
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Must match the lifetime the frontend expects a session to last.
JWT_EXPIRES_IN=1d
# Cost factor for password hashing. 12 is a good balance; lower only in tests.
BCRYPT_SALT_ROUNDS=12

# Cookies
# Set COOKIE_SECURE=true only when the API is served over HTTPS. Enabling it
# over plain HTTP makes the browser silently drop the cookie, which looks
# exactly like a failed login.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

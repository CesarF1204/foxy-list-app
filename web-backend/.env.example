# Cost factor for password hashing. 12 is a good balance; lower only in tests.
BCRYPT_SALT_ROUNDS=12

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary Variables
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=5000
MONGODB_URI=

# Client
# The production Vercel URL, comma-separated for preview deployments. It also decides the session
# cookie's SameSite: any public origin here means the API is cross-site, so the cookie is sent as
# SameSite=None; Secure. Keep localhost-only for local development.
FRONTEND_URL=http://localhost:5173

# Cost factor for password hashing. 12 is a good balance; lower only in tests.
BCRYPT_SALT_ROUNDS=12

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cookies
# Set COOKIE_SECURE=true only when the API is served over HTTPS. Enabling it
# over plain HTTP makes the browser silently drop the cookie, which looks
# exactly like a failed login.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
